// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
    url      = env("DATABASE_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  gmail String  @unique
  password	String
  name  String
  role	String	@default("USER")
  nivelSuscripcion String @default("Gratis")
  fechaVencimientoSuscripcion DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bannerColor String @default("#1e293b")
  suscripcionCancelada Boolean @default(false)
  nextNivelSuscripcion String?
  projects  Project[]
  facturas  Factura[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Archivo {
  idProject Int
  id    Int @id @default(autoincrement())
  texto String?
  descripcion String?
  estado String @default("No Iniciado")
  from  ArchivoRelacion[] @relation("from")
  to    ArchivoRelacion[] @relation("to")
  x     Int    @default(0)
  y     Int    @default(0)
  deadline  DateTime?
 }

model ArchivoRelacion {
  id    Int @id @default(autoincrement())
  fromId Int
  toId  Int
  from  Archivo @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  to    Archivo @relation("to", fields: [toId], references: [id], onDelete: Cascade)
}

model Factura {
  id        Int      @id @default(autoincrement())
  tipo      String
  cuit      String?
  nombreFacturacion String?
  montoNeto Float
  iva       Float
  total     Float
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model AsientoContable {
  id        Int      @id @default(autoincrement())
  concepto  String
  monto     Float
  tipoCuenta String 
  createdAt DateTime @default(now())
}